[Unit]
Description=Validate the active Policy Data Italia release
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=catone
WorkingDirectory=/opt/policy-data
EnvironmentFile=/opt/policy-data/.env
ExecStart=/opt/policy-data/scripts/refresh_and_restart.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
